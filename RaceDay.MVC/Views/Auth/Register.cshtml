@{
    ViewData["Title"]="Register";
}
<h2>Register</h2>
<form method="post">
  <div class="mb-3"><label>Full Name</label><input name="fullName" class="form-control" required /></div>
  <div class="mb-3"><label>Email</label><input name="email" class="form-control" required /></div>
  <div class="mb-3"><label>Password</label><input name="password" type="password" class="form-control" required /></div>
  <div class="mb-3"><label>Role</label><select name="role" class="form-select"><option>Participant</option><option>Organizer</option></select></div>
  <button class="btn btn-primary">Register</button>
</form>
