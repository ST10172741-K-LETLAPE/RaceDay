@{
    ViewData["Title"] = "Results Entry";
    var results = Model as System.Text.Json.JsonDocument;
    var enrols = ViewBag.Enrolments as System.Text.Json.JsonDocument;
}
<h2>Results Entry - Event @ViewBag.EventId</h2>
<p class="text-muted">Capture and publish finish times and finishing positions after event concludes</p>

<div class="row">
<div class="col-md-8">
<h4>Enrolled Participants</h4>
@if(enrols == null)
{
  <div class="alert alert-info">No enrolments yet for this event. Participants will appear here after they enrol.</div>
}
else
{
  <table class="table table-bordered">
    <thead><tr><th>Participant</th><th>Finish Time</th><th>Position</th><th>Action</th></tr></thead>
    <tbody>
    @foreach(var e in enrols.RootElement.EnumerateArray())
    {
      <tr>
        <td><small>@e.ToString().Substring(0, Math.Min(80, e.ToString().Length))</small></td>
        <td>
          <form method="post" action="/Results/Publish" class="d-flex gap-1">
            <input type="hidden" name="eventId" value="@ViewBag.EventId" />
            <input type="hidden" name="enrolmentId" value="1" />
            <input type="text" name="finishTime" class="form-control form-control-sm" placeholder="e.g. 00:45:23" style="width:110px" />
            <input type="number" name="position" class="form-control form-control-sm" placeholder="Pos" style="width:70px" />
            <button class="btn btn-sm btn-success">Publish</button>
          </form>
        </td>
        <td>-</td>
        <td><span class="badge bg-secondary">Pending</span></td>
      </tr>
    }
    </tbody>
  </table>
}
</div>
<div class="col-md-4">
<h4>Published Results</h4>
@if(results == null)
{
  <div class="alert alert-secondary">No results published yet</div>
}
else
{
  foreach(var r in results.RootElement.EnumerateArray())
  {
    <div class="card mb-2"><div class="card-body"><small>@r.ToString()</small></div></div>
  }
}
</div>
</div>
<a href="/Dashboard/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
