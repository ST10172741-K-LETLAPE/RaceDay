<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RaceDay - @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">RaceDay 🏃</a>
    <div class="navbar-nav ms-auto d-flex flex-row">
@{
    var role = Context.Session.GetString("role");
    var email = Context.Session.GetString("email");
    if (string.IsNullOrEmpty(email))
    {
        <a class="nav-link text-white me-3" href="/Auth/Login">Login</a>
        <a class="nav-link text-white" href="/Auth/Register">Register</a>
    }
    else
    {
        if (role == "Organizer")
        {
            <a class="nav-link text-white me-3" href="/Dashboard/Dashboard">Dashboard</a>
            <a class="nav-link text-white me-3" href="/Events/Create">Create Event</a>
        }
        else
        {
            <a class="nav-link text-white me-3" href="/Events">Events</a>
            <a class="nav-link text-white me-3" href="/Events/MyEnrolments">My Events</a>
        }
        <span class="nav-link text-white-50 me-3">@email (@role)</span>
        <a class="nav-link text-white" href="/Auth/Logout">Logout</a>
    }
}
    </div>
  </div>
</nav>
<div class="container mt-4">
    @RenderBody()
</div>
</body>
</html>