@{
    ViewData["Title"]="Create Event";
}
<h2>Create Event</h2>
<form method="post" enctype="multipart/form-data">
  <div class="mb-3"><label>Title</label><input name="title" class="form-control" required /></div>
  <div class="mb-3"><label>Description</label><textarea name="description" class="form-control"></textarea></div>
  <div class="mb-3"><label>Date</label><input name="eventDate" type="date" class="form-control" required /></div>
  <div class="mb-3"><label>Location</label><input name="location" class="form-control" required /></div>
  <div class="mb-3"><label>Banner Image (Blob)</label><input name="banner" type="file" class="form-control" accept="image/*" /></div>
  <button class="btn btn-primary">Create</button>
</form>
