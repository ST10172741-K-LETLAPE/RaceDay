<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">RaceDay 🏃</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @{
                            var role = Context.Session.GetString("role");
                            var email = Context.Session.GetString("email");
                        }
                        @if(!string.IsNullOrEmpty(email))
                        {
                            @if(role == "Organizer")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/Dashboard/Dashboard">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Events/Create">Create Event</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Events">All Events</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Categories/Index?eventId=1">Categories</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Results/Entry?eventId=1">Results</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Profile">Profile</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/Events">Events</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Events/MyEnrolments">My Events</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Results/MyResults">My Results</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Profile">Profile</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-warning" href="/Auth/Logout">Logout (@email - @role)</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Auth/Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Auth/Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container">
            &copy; 2026 - RaceDay - POE Final Part 3
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
